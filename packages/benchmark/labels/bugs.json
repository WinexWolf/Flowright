{
  "note": "Injected bugs, toggled via FLOWRIGHT_BUGS. 'detect' says what kind of evidence should reveal it: tier1 = objective browser signal (console/network/overflow/dead click/404), form-probe = needs a deliberate empty/invalid form submit. 'split' dev|heldout.",
  "bugs": [
    {
      "id": "shop-broken-link",
      "app": "shop",
      "kind": "broken-link",
      "detect": "tier1",
      "split": "dev",
      "where": "footer Help link -> 404",
      "match": {
        "kinds": [
          "broken-link"
        ],
        "route": "^/help-center$"
      }
    },
    {
      "id": "shop-console-error",
      "app": "shop",
      "kind": "console-error",
      "detect": "tier1",
      "split": "dev",
      "where": "/about",
      "match": {
        "kinds": [
          "console-error"
        ],
        "route": "^/about$"
      }
    },
    {
      "id": "shop-failing-api",
      "app": "shop",
      "kind": "failed-request",
      "detect": "tier1",
      "split": "heldout",
      "where": "/products/:id stock call 500",
      "match": {
        "kinds": [
          "failed-request"
        ],
        "route": "^/products/\\d+$"
      }
    },
    {
      "id": "shop-dead-add-to-cart",
      "app": "shop",
      "kind": "dead-click",
      "detect": "tier1",
      "split": "dev",
      "where": "/products/:id Add to cart",
      "match": {
        "kinds": [
          "dead-click",
          "console-error"
        ],
        "route": "^/products/\\d+$"
      }
    },
    {
      "id": "shop-layout-overflow",
      "app": "shop",
      "kind": "overflow",
      "detect": "tier1",
      "split": "dev",
      "where": "/products",
      "match": {
        "kinds": [
          "overflow"
        ],
        "route": "^/products"
      },
      "matchOriginal": {
        "kinds": [
          "overflow"
        ],
        "route": "^/products$"
      }
    },
    {
      "id": "shop-missing-validation",
      "app": "shop",
      "kind": "missing-validation",
      "detect": "form-probe",
      "split": "dev",
      "where": "/checkout accepts invalid email",
      "match": {
        "kinds": [
          "missing-validation"
        ],
        "route": "^/checkout$"
      }
    },
    {
      "id": "tasks-broken-link",
      "app": "tasks",
      "kind": "empty-route",
      "detect": "tier1",
      "split": "dev",
      "where": "nav Reports -> blank screen",
      "match": {
        "kinds": [
          "empty-route"
        ],
        "route": "^/#/report$"
      }
    },
    {
      "id": "tasks-console-error",
      "app": "tasks",
      "kind": "console-error",
      "detect": "tier1",
      "split": "heldout",
      "where": "#/settings Notifications tab",
      "match": {
        "kinds": [
          "console-error"
        ],
        "route": "^/#/settings$"
      }
    },
    {
      "id": "tasks-failing-api",
      "app": "tasks",
      "kind": "failed-request",
      "detect": "tier1",
      "split": "dev",
      "where": "#/projects",
      "match": {
        "kinds": [
          "failed-request",
          "console-error"
        ],
        "route": "^/#/projects$"
      },
      "matchOriginal": {
        "kinds": [
          "failed-request"
        ],
        "route": "^/#/projects$"
      }
    },
    {
      "id": "tasks-dead-mark-done",
      "app": "tasks",
      "kind": "dead-click",
      "detect": "tier1",
      "split": "dev",
      "where": "task detail Mark as done",
      "match": {
        "kinds": [
          "dead-click",
          "console-error"
        ],
        "route": "^/#/tasks/\\d+$"
      }
    },
    {
      "id": "tasks-layout-overflow",
      "app": "tasks",
      "kind": "overflow",
      "detect": "tier1",
      "split": "heldout",
      "where": "dashboard",
      "match": {
        "kinds": [
          "overflow"
        ],
        "route": "^/(#/)?$"
      }
    },
    {
      "id": "tasks-missing-validation",
      "app": "tasks",
      "kind": "missing-validation",
      "detect": "form-probe",
      "split": "dev",
      "where": "New task accepts empty title",
      "match": {
        "kinds": [
          "missing-validation"
        ],
        "route": "^/#/tasks$"
      }
    },
    {
      "id": "lib-broken-link",
      "app": "library",
